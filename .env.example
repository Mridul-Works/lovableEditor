DATABASE_URL="file:./prisma/dev.db"

# 32+ char secret used to sign session cookies AND to encrypt the stored
# GitHub token. Rotating it signs everyone out and disconnects GitHub.
AUTH_SECRET="change-me-to-a-long-random-string"

# Seeded admin credentials (npm run db:seed).
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="change-me"

# Image storage. "local" writes to UPLOADS_DIR and serves via /uploads/*.
# An S3-compatible driver can be added in src/lib/storage.ts and selected here.
STORAGE_DRIVER="local"
UPLOADS_DIR="./uploads"

# Optional. Set GITHUB_TOKEN to pin the token from the environment instead of
# managing it in the UI. GITHUB_API_BASE points at GitHub Enterprise or a test
# double; it defaults to https://api.github.com.
# GITHUB_TOKEN=""
# GITHUB_API_BASE="https://api.github.com"
